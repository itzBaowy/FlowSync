# Copy to .env.production on the server and replace every placeholder; never commit the real file.
# Compose also reads this file for public domain/release interpolation via --env-file.
FLOWSYNC_DOMAIN=app.example.com
ACME_EMAIL=operator@example.com
FLOWSYNC_RELEASE=CHANGE_ME_COMMIT_SHA
NODE_ENV=production
API_PORT=4000
WEB_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://app.example.com/api
TRUST_PROXY_HOPS=1
# Provision isolated private PostgreSQL/Redis and a private S3 bucket before starting the app.
DATABASE_URL=postgresql://flowsync:CHANGE_ME@private-postgres:5432/flowsync?schema=public
REDIS_HOST=private-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
JWT_ACCESS_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_MINIMUM_32_CHARACTERS
JWT_ISSUER=flowsync-production-api
JWT_AUDIENCE=flowsync-production-web
MINIO_ENDPOINT=https://s3.example.com
MINIO_PUBLIC_ENDPOINT=https://s3.example.com
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME_MINIMUM_8_CHARACTERS
MINIO_BUCKET=flowsync-production
S3_REGION=us-east-1
SMTP_URL=smtps://CHANGE_ME:CHANGE_ME@smtp.example.com:465
EMAIL_FROM=no-reply@example.com
EMAIL_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
AI_PROVIDER=disabled
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
