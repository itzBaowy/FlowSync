# Run npm run setup to create .env with random LOCAL secrets. Never commit .env.
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
DATABASE_URL=postgresql://flowsync:CHANGE_ME@localhost:5432/flowsync?schema=public
POSTGRES_USER=flowsync
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=flowsync
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
JWT_ACCESS_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_MINIMUM_32_CHARACTERS
JWT_ISSUER=flowsync-api
JWT_AUDIENCE=flowsync-web
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=flowsync-local
MINIO_SECRET_KEY=CHANGE_ME_MINIMUM_8_CHARACTERS
MINIO_BUCKET=flowsync
S3_REGION=us-east-1
# Enable only behind a known proxy; 0 means no proxy trust.
TRUST_PROXY_HOPS=0
# Reserved for future milestones.
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Blank uses local Mailpit. Use smtp:// or smtps:// credentials in production.
SMTP_URL=
EMAIL_FROM=no-reply@flowsync.local
EMAIL_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
