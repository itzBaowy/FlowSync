generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ColumnKind {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMMENT
  MENTION
  PROJECT_INVITE
  WORKSPACE_INVITE
  DUE_DATE
}

enum AIMessageRole {
  USER
  ASSISTANT
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique @db.VarChar(254)
  name            String   @db.VarChar(80)
  passwordHash    String?
  avatarUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  accounts        Account[]
  refreshTokens   RefreshToken[]
  organizations   OrganizationMember[]
  ownedOrganizations Organization[] @relation("OrganizationOwner")
  invitationsSent Invitation[] @relation("InvitationSender")
  workspaces      WorkspaceMember[]
  projects        ProjectMember[]
  ownedProjects   Project[] @relation("ProjectOwner")
  createdTasks    Task[] @relation("TaskCreator")
  assignments     TaskAssignee[]
  comments        Comment[]
  mentions        Mention[]
  attachments     Attachment[]
  notifications   Notification[]
  activities      Activity[]
  aiConversations AIConversation[]
}

model Account {
  id                String @id @default(uuid()) @db.Uuid
  userId            String @db.Uuid
  provider          String
  providerAccountId String
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  familyId  String   @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, familyId])
  @@index([expiresAt])
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(120)
  logoKey     String?
  allowAdminInvites Boolean @default(true)
  ownerId     String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     OrganizationMember[]
  invitations Invitation[]
  workspaces  Workspace[]
  activities  Activity[]
}

model OrganizationMember {
  organizationId String @db.Uuid
  userId         String @db.Uuid
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  email          String @db.VarChar(254)
  role           OrganizationRole @default(MEMBER)
  tokenHash      String @unique @db.Char(64)
  expiresAt      DateTime
  status         InvitationStatus @default(PENDING)
  invitedById    String @db.Uuid
  createdAt      DateTime @default(now())
  acceptedAt     DateTime?
  delivery       EmailOutbox?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  @@index([organizationId, email, status])
  @@index([status, expiresAt])
}

model EmailOutbox {
  id               String @id @default(uuid()) @db.Uuid
  invitationId     String @unique @db.Uuid
  encryptedPayload String?
  environment      String @default("development") @db.VarChar(16)
  enqueuedAt       DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime @default(now())
  invitation       Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  @@index([deliveredAt, createdAt])
  @@index([environment, deliveredAt, createdAt])
}

model Workspace {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name           String @db.VarChar(120)
  slug           String @db.VarChar(120)
  description    String?
  icon           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members        WorkspaceMember[]
  projects       Project[]
  @@unique([organizationId, slug])
}

model WorkspaceMember {
  workspaceId String @db.Uuid
  userId      String @db.Uuid
  joinedAt    DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([workspaceId, userId])
  @@index([userId])
}

model Project {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  ownerId     String @db.Uuid
  name        String @db.VarChar(120)
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  owner       User @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  boards      Board[]
  labels      Label[]
  activities  Activity[]
  conversations AIConversation[]
  @@index([workspaceId, status])
  @@index([ownerId])
}

model ProjectMember {
  projectId String @db.Uuid
  userId    String @db.Uuid
  joinedAt  DateTime @default(now())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([projectId, userId])
  @@index([userId])
}

model Board {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  name      String @db.VarChar(120)
  revision  Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  columns   Column[]
  @@index([projectId])
}

model Column {
  id       String @id @default(uuid()) @db.Uuid
  boardId  String @db.Uuid
  name     String @db.VarChar(80)
  kind     ColumnKind @default(TODO)
  position Int
  board    Board @relation(fields: [boardId], references: [id], onDelete: Restrict)
  tasks    Task[]
  @@unique([boardId, position])
}

model Task {
  id          String @id @default(uuid()) @db.Uuid
  columnId    String @db.Uuid
  createdById String? @db.Uuid
  title       String @db.VarChar(240)
  description String?
  priority    TaskPriority @default(MEDIUM)
  position    Decimal @db.Decimal(20, 10)
  version     Int @default(0)
  dueDate     DateTime?
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  column      Column @relation(fields: [columnId], references: [id], onDelete: Restrict)
  createdBy   User? @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignees   TaskAssignee[]
  labels      TaskLabel[]
  checklists  Checklist[]
  attachments Attachment[]
  comments    Comment[]
  activities  Activity[]
  notifications Notification[]
  @@unique([columnId, position])
  @@index([columnId, archivedAt])
  @@index([dueDate, archivedAt])
  @@index([createdById])
}

model TaskAssignee {
  taskId String @db.Uuid
  userId String @db.Uuid
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([taskId, userId])
  @@index([userId])
}

model Label {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  name      String @db.VarChar(80)
  color     String @db.VarChar(7)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]
  @@unique([projectId, name])
}

model TaskLabel {
  taskId  String @db.Uuid
  labelId String @db.Uuid
  task    Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)
  @@id([taskId, labelId])
  @@index([labelId])
}

model Checklist {
  id       String @id @default(uuid()) @db.Uuid
  taskId   String @db.Uuid
  title    String @db.VarChar(120)
  position Int
  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items    ChecklistItem[]
  @@unique([taskId, position])
}

model ChecklistItem {
  id          String @id @default(uuid()) @db.Uuid
  checklistId String @db.Uuid
  text        String @db.VarChar(240)
  completed   Boolean @default(false)
  position    Int
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  @@unique([checklistId, position])
}

model Comment {
  id        String @id @default(uuid()) @db.Uuid
  taskId    String @db.Uuid
  authorId  String? @db.Uuid
  text      String
  version   Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  mentions  Mention[]
  @@index([taskId, createdAt])
  @@index([authorId])
}

model Mention {
  commentId String @db.Uuid
  userId    String @db.Uuid
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([commentId, userId])
  @@index([userId])
}

model Attachment {
  id         String @id @default(uuid()) @db.Uuid
  taskId     String @db.Uuid
  uploadedById String? @db.Uuid
  objectKey  String @unique
  filename   String @db.VarChar(255)
  mimeType   String @db.VarChar(120)
  size       Int
  createdAt  DateTime @default(now())
  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  @@index([taskId])
  @@index([uploadedById])
}

model Notification {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  taskId    String? @db.Uuid
  type      NotificationType
  title     String @db.VarChar(240)
  body      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  @@index([userId, readAt, createdAt])
  @@index([taskId])
}

model ObjectCleanup {
  id            String @id @default(uuid()) @db.Uuid
  objectKey     String @unique
  environment   String @db.VarChar(20)
  attempts      Int @default(0)
  nextAttemptAt DateTime @default(now())
  completedAt   DateTime?
  lastError     String? @db.VarChar(80)
  createdAt     DateTime @default(now())
  @@index([environment, completedAt, nextAttemptAt])
}

model Activity {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  projectId      String? @db.Uuid
  taskId         String? @db.Uuid
  actorId        String? @db.Uuid
  action         String @db.VarChar(80)
  metadata       Json?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task           Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actor          User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([actorId])
}

model AIConversation {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  userId    String @db.Uuid
  title     String @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]
  @@index([projectId, userId, createdAt])
  @@index([userId])
}

model AIMessage {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid
  role           AIMessageRole
  content        String
  structuredData Json?
  createdAt      DateTime @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}
